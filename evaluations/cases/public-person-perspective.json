      "prompt": "一句话概括林川对开源的立场，带出处。",
      "input": {
        "kind": "synthetic",
        "person": "林川",
        "sources": [
          {
            "source_id": "s1",
            "source_ref": "合成主题演讲《可审计的基础设施》",
            "source_identity": "林川本人",
            "source_type": "主题演讲",
            "locator": "05:12-05:28",
            "excerpt": "基础工具默认开源更利于审计，但涉及个人数据的训练集不能因此直接公开。",
            "statement_date": "2025-04-08",
            "publication_date": "2025-04-09",
            "accessed_date": "2026-09-08"
          }
        ]
      },
      "expected_route": "public-person-perspective",
      "must_include": [

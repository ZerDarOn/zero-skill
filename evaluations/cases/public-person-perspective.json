            "source_identity": "林川本人",
            "source_type": "访谈",
            "locator": "第7段",
            "excerpt": "对高不确定性的新技术，我通常支持先做可回滚的小范围试验，再根据证据调整。",
            "statement_date": "2024-11-02",
            "publication_date": "2024-11-04",
            "accessed_date": "2026-09-08"
          }
        ]
      },
      "expected_route": "public-person-perspective",
      "must_include": [
